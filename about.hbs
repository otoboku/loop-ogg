<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Third-Party Licenses</title>
    <style>
        body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; padding: 30px; max-width: 900px; margin: 0 auto; line-height: 1.6; color: #333; }
        h1 { border-bottom: 2px solid #eaecef; padding-bottom: 10px; }
        h2 { margin-top: 30px; border-bottom: 1px solid #eaecef; padding-bottom: 5px; }
        .crate { background: #f6f8fa; padding: 15px; border-radius: 6px; margin-bottom: 15px; border: 1px solid #e1e4e8; }
        .crate-list { margin: 8px 0; padding-left: 20px; column-count: 2; }
        pre { background: #f1f3f5; padding: 12px; border-radius: 4px; overflow-x: auto; font-size: 13px; white-space: pre-wrap; word-break: break-all; }
        summary { cursor: pointer; font-weight: bold; color: #0366d6; margin-top: 10px; }
    </style>
</head>
<body>
    <h1>Third-Party Software Notices</h1>
    <p>This document contains license and copyright notices for third-party software used in this package.</p>

    <h2>C/C++ System Dependencies</h2>
    <div class="crate">
        <h3>libsoxr</h3>
        <p><strong>License:</strong> LGPL-2.1-or-later / BSD-3-Clause</p>
        <p>Copyright (c) 2013 Rob Sykes. Source code available at <a href="https://sourceforge.net/projects/soxr/" target="_blank">SourceForge</a>.</p>
    </div>
    <div class="crate">
        <h3>PortAudio</h3>
        <p><strong>License:</strong> MIT License (SCAE)</p>
        <p>Copyright (c) 1999-2006 Ross Bencina and Phil Burk. Website: <a href="http://www.portaudio.com/" target="_blank">portaudio.com</a>.</p>
    </div>

    <h2>Rust Crates</h2>
    {{#each licenses}}
    <div class="crate">
        <h3>{{this.name}}</h3>
        <p><strong>Used by:</strong></p>
        <ul class="crate-list">
        {{#each this.used_by}}
            <li><code>{{this.crate.name}} v{{this.crate.version}}</code></li>
        {{/each}}
        </ul>
        <details>
            <summary>View {{this.name}} Full Text</summary>
            <pre>{{this.text}}</pre>
        </details>
    </div>
    {{/each}}
</body>
</html>
